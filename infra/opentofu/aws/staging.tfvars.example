environment             = "staging"
aws_region              = "ap-south-1"
expected_aws_account_id = "123456789012"
vpc_cidr                = "10.40.0.0/16"
kubernetes_version      = "1.34"

route53_zone_id = "Z0000000000000000000"
public_host      = "staging.play.gamearena.example"
game_host        = "staging.games.gamearena.example"

# Separate protected GitHub OIDC roles for infrastructure/deployment and
# namespace-scoped runtime controls.
github_deploy_role_arn  = "arn:aws:iam::123456789012:role/game-arena-staging-deploy"
github_runtime_role_arn = "arn:aws:iam::123456789012:role/game-arena-staging-runtime"

operations_alert_email = "operations@gamearena.example"
monthly_budget_usd     = 250

# GitHub-hosted runners do not have fixed egress addresses. Restrict this to a
# self-hosted runner or approved fixed egress CIDRs before production.
cluster_public_access_cidrs = ["0.0.0.0/0"]

single_nat_gateway           = true
node_instance_types          = ["t3.medium"]
node_min                     = 2
node_desired                 = 2
node_max                     = 4
database_instance_class      = "db.t4g.medium"
database_multi_az            = false
database_deletion_protection = false

tags = {
  Owner      = "Game Arena"
  CostCenter = "game-arena"
}
