{
  "schemaVersion": 1,
  "contractVersion": "1.0.0",
  "basePath": "/",
  "authentication": {
    "player": "Opaque HttpOnly session cookie plus CSRF cookie/header for mutations.",
    "admin": "Signed identity-proxy assertion with server-enforced roles.",
    "preview": "Vercel runs mode=mock and must never receive production secrets."
  },
  "errorEnvelope": {
    "error": {
      "code": "string",
      "message": "string",
      "details": "object|null"
    }
  },
  "routes": [
