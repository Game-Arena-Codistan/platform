    {"method":"POST","path":"/v1/auth/otp","auth":"public","successStatus":202,"mockExample":"otpRequested"},
    {"method":"POST","path":"/v1/auth/otp/verify","auth":"public","successStatus":200,"mockExample":"otpVerified"},
    {"method":"GET","path":"/v1/session","auth":"optional","successStatus":200,"mockExample":"sessionAnonymous"},
    {"method":"POST","path":"/v1/auth/logout","auth":"session","successStatus":204},
