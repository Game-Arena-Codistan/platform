NODE_ENV=development
PORT=8081
PUBLIC_ORIGIN=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:8080
DATABASE_URL=postgres://game_arena:change-me@postgres:5432/game_arena
DATABASE_SSL=false
REQUIRE_DATABASE=false
SESSION_COOKIE_NAME=ga_session
CSRF_COOKIE_NAME=ga_csrf
SESSION_TTL_SECONDS=2592000
SESSION_ROTATION_SECONDS=86400
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=30
OTP_MAX_ATTEMPTS=5
OTP_ACCOUNT_LIMIT=5
OTP_IP_LIMIT=20
OTP_DEVICE_LIMIT=10
ALLOW_DEBUG_OTP=true
OTP_PROVIDER_MODE=mock
# For Brevo delivery use OTP_PROVIDER_MODE=brevo and set BREVO_API_KEY.
# Email OTP additionally requires a verified Brevo sender email.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Game Arena
# Phone OTP additionally requires an SMS sender configured for your Brevo account.
BREVO_SMS_SENDER=
OTP_PRIMARY_NAME=primary
OTP_PRIMARY_ENDPOINT=
OTP_PRIMARY_API_KEY=
OTP_SECONDARY_NAME=secondary
OTP_SECONDARY_ENDPOINT=
OTP_SECONDARY_API_KEY=

# External payment-service integration for Game Arena+ wallet subscriptions.
# Keep MODE=disabled until the staging payment-service values are supplied.
PAYMENT_SERVICE_MODE=disabled
PAYMENT_SERVICE_URL=
PAYMENT_SERVICE_API_KEY=
PAYMENT_SERVICE_WEBHOOK_SECRET=
PAYMENT_SERVICE_APP_RETURN_URL=http://localhost:8080/#/premium
PAYMENT_SERVICE_TIMEOUT_MS=8000

# Legacy direct JazzCash settings remain for existing non-subscription payment paths.
JAZZCASH_MODE=mock
JAZZCASH_WEBHOOK_SECRET=replace-me
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_ACTION_URL=
JAZZCASH_RETURN_URL=
ADMIN_API_KEYS=
REWARD_DAILY_CAP=1000
HIGH_RISK_ADJUSTMENT_THRESHOLD=5000
ACCOUNT_RETENTION_DAYS=30
