/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://payments.jazzcash.com.pk https://sandbox.jazzcash.com.pk; frame-ancestors 'none'; upgrade-insecure-requests

/index.html
  Cache-Control: no-cache, no-store, must-revalidate
/config.js
  Cache-Control: no-store
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.css
  Cache-Control: public, max-age=31536000, immutable
/*.svg
  Cache-Control: public, max-age=86400
