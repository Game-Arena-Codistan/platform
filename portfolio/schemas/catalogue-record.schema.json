{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://game-arena.example/schemas/catalogue-record.schema.json",
  "title":"Game Arena catalogue record",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","slug","title","engine","runtimeClass","tier","orientation","source","rights","release","certification","operations"],
  "properties":{
    "schemaVersion":{"const":"1.0.0"},
    "slug":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$","maxLength":80},
    "title":{"type":"string","minLength":1,"maxLength":160},
    "engine":{"enum":["html5","construct2","construct3","unity-webgl","godot-web","other"]},
    "runtimeClass":{"enum":["static","external-api","realtime"]},
    "tier":{"enum":["free","premium"]},
    "orientation":{"enum":["portrait","landscape","responsive"]},
    "source":{
      "type":"object","additionalProperties":false,
      "required":["manifestRef","state","shard"],
      "properties":{
        "manifestRef":{"type":"string","pattern":"^sources/[a-z0-9-]+\\.json$"},
        "state":{"enum":["missing","discovered","archived","reviewable"]},
        "shard":{"type":["string","null"],"pattern":"^[a-z0-9-]+$"},
        "originalAvailable":{"type":"boolean"},
        "modifiedAvailable":{"type":"boolean"}
      }
    },
    "rights":{
      "type":"object","additionalProperties":false,
      "required":["state","reference","storage","modify","host","distribute"],
      "properties":{
        "state":{"enum":["blocked","pending","approved"]},
        "reference":{"type":["string","null"],"maxLength":200},
        "storage":{"type":"boolean"},"modify":{"type":"boolean"},"host":{"type":"boolean"},"distribute":{"type":"boolean"},
        "artworkAudio":{"enum":["blocked","pending","approved","not-applicable"]}
      }
    },
    "release":{
      "type":"object","additionalProperties":false,
      "required":["activeVersion","candidateVersion","state"],
      "properties":{
        "activeVersion":{"type":["string","null"],"pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$"},
        "candidateVersion":{"type":["string","null"],"pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$"},
        "state":{"enum":["none","built","scanned","staged","active","retired"]},
        "manifestRef":{"type":["string","null"],"pattern":"^releases/[a-z0-9-]+/[0-9A-Za-z.-]+\\.json$"}
      }
    },
    "certification":{
      "type":"object","additionalProperties":false,
      "required":["state","integrityPolicy"],
      "properties":{
        "state":{"enum":["not-started","blocked","in-review","approved","rejected"]},
        "recordRef":{"type":["string","null"],"pattern":"^certifications/[a-z0-9-]+/[0-9A-Za-z.-]+\\.json$"},
        "integrityPolicy":{"enum":["play-only","duration","score","completion","server-authoritative"]}
      }
    },
    "operations":{
      "type":"object","additionalProperties":false,
      "required":["status","rolloutPercentage","rewardsEnabled","competitionsEnabled"],
      "properties":{
        "status":{"enum":["inactive","paused","active","retired"]},
        "rolloutPercentage":{"type":"integer","minimum":0,"maximum":100},
        "rewardsEnabled":{"type":"boolean"},
        "competitionsEnabled":{"type":"boolean"}
      }
    },
    "tags":{"type":"array","maxItems":30,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z0-9-]{1,40}$"}},
    "updatedAt":{"type":"string","format":"date-time"}
  }
}
