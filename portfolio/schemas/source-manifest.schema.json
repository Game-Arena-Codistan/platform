{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://game-arena.example/schemas/source-manifest.schema.json",
  "title":"Game Arena source manifest",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","slug","engine","runtimeClass","discoveredAt","packages","reviewableSource","provenance"],
  "properties":{
    "schemaVersion":{"const":"1.0.0"},
    "slug":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "engine":{"enum":["html5","construct2","construct3","unity-webgl","godot-web","other"]},
    "runtimeClass":{"enum":["static","external-api","realtime"]},
    "discoveredAt":{"type":"string","format":"date-time"},
    "packages":{
      "type":"array","minItems":1,"maxItems":4,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["kind","relativePath","sha256","bytes","archiveState"],
        "properties":{
          "kind":{"enum":["original","modified","build","documentation"]},
          "relativePath":{"type":"string","minLength":1,"maxLength":500,"not":{"pattern":"(^|/)\\.\\.(/|$)|^[A-Za-z]:|^/"}},
          "sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
          "bytes":{"type":"integer","minimum":0},
          "fileCount":{"type":"integer","minimum":0},
          "archiveState":{"enum":["local-only","planned","archived","verified"]},
          "vaultKey":{"type":["string","null"],"pattern":"^sources/[a-z0-9-]+/[a-z0-9-]+/[a-f0-9]{64}\\.zip$"}
        }
      }
    },
    "reviewableSource":{
      "type":"object","additionalProperties":false,
      "required":["state","shard","path"],
      "properties":{
        "state":{"enum":["not-required","pending","imported","blocked"]},
        "shard":{"type":["string","null"],"pattern":"^[a-z0-9-]+$"},
        "path":{"type":["string","null"],"pattern":"^games/[a-z0-9-]+/$"},
        "blockedReason":{"type":["string","null"],"maxLength":500}
      }
    },
    "provenance":{
      "type":"object","additionalProperties":false,
      "required":["sourceOwner","rightsReference","inventoryReference"],
      "properties":{
        "sourceOwner":{"type":["string","null"],"maxLength":160},
        "rightsReference":{"type":["string","null"],"maxLength":200},
        "inventoryReference":{"type":"string","maxLength":300},
        "notes":{"type":["string","null"],"maxLength":1000}
      }
    }
  }
}
