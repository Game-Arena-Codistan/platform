{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://game-arena.example/schemas/release-manifest.schema.json",
  "title":"Game Arena immutable release manifest",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","slug","version","sourceManifestRef","artifact","scanner","runtime","createdAt"],
  "properties":{
    "schemaVersion":{"const":"1.0.0"},
    "slug":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$"},
    "sourceManifestRef":{"type":"string","pattern":"^sources/[a-z0-9-]+\\.json$"},
    "artifact":{
      "type":"object","additionalProperties":false,
      "required":["key","sha256","bytes","entryPoint","fileCount"],
      "properties":{
        "key":{"type":"string","pattern":"^games/[a-z0-9-]+/[0-9A-Za-z.-]+/release\\.zip$"},
        "sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "bytes":{"type":"integer","minimum":1},
        "entryPoint":{"const":"index.html"},
        "fileCount":{"type":"integer","minimum":1},
        "manifestKey":{"type":"string","pattern":"^games/[a-z0-9-]+/[0-9A-Za-z.-]+/manifest\\.json$"}
      }
    },
    "scanner":{
      "type":"object","additionalProperties":false,
      "required":["state","reportSha256","critical","high","blockedFiles","remoteExecutables"],
      "properties":{
        "state":{"enum":["passed","failed"]},
        "reportSha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "critical":{"type":"integer","minimum":0},"high":{"type":"integer","minimum":0},
        "blockedFiles":{"type":"integer","minimum":0},"remoteExecutables":{"type":"integer","minimum":0}
      }
    },
    "runtime":{
      "type":"object","additionalProperties":false,
      "required":["runtimeClass","gameBridge","networkHosts","status","rolloutPercentage"],
      "properties":{
        "runtimeClass":{"enum":["static","external-api","realtime"]},
        "gameBridge":{"enum":["none","lifecycle","completion","score","server-authoritative"]},
        "networkHosts":{"type":"array","uniqueItems":true,"maxItems":50,"items":{"type":"string","pattern":"^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"}},
        "status":{"enum":["inactive","paused","active","retired"]},
        "rolloutPercentage":{"type":"integer","minimum":0,"maximum":100}
      }
    },
    "createdAt":{"type":"string","format":"date-time"},
    "createdBy":{"type":"string","maxLength":100},
    "provenance":{"type":"object","additionalProperties":false,"properties":{"workflowRun":{"type":"string","maxLength":200},"commitSha":{"type":"string","pattern":"^[a-f0-9]{40}$"}}}
  }
}
