{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://game-arena.example/schemas/certification-record.schema.json",
  "title":"Game Arena release certification record",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","slug","version","decision","testedAt","gameplay","bridge","integrity","security","devices","rollback"],
  "properties":{
    "schemaVersion":{"const":"1.0.0"},
    "slug":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$"},
    "decision":{"enum":["blocked","rejected","approved-play-only","approved-rewards","approved-competition"]},
    "testedAt":{"type":"string","format":"date-time"},
    "gameplay":{"$ref":"#/$defs/check"},
    "bridge":{"$ref":"#/$defs/check"},
    "integrity":{"$ref":"#/$defs/check"},
    "security":{"$ref":"#/$defs/check"},
    "rollback":{"$ref":"#/$defs/check"},
    "devices":{
      "type":"array","minItems":1,"maxItems":50,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["platform","browser","viewport","result"],
        "properties":{
          "platform":{"enum":["windows","macos","linux","android","ios"]},
          "browser":{"enum":["chromium","chrome","edge","firefox","webkit","safari"]},
          "viewport":{"type":"string","pattern":"^[0-9]{2,5}x[0-9]{2,5}$"},
          "network":{"enum":["normal","slow","interrupted"]},
          "result":{"enum":["passed","failed","blocked"]},
          "evidenceRef":{"type":["string","null"],"maxLength":300}
        }
      }
    },
    "approvals":{
      "type":"array","maxItems":10,
      "items":{"type":"object","additionalProperties":false,"required":["role","reference"],"properties":{"role":{"enum":["engineering","security","product","rights","operations"]},"reference":{"type":"string","maxLength":200}}}
    },
    "notes":{"type":["string","null"],"maxLength":2000}
  },
  "$defs":{
    "check":{
      "type":"object","additionalProperties":false,
      "required":["result","evidenceRef"],
      "properties":{"result":{"enum":["passed","failed","blocked","not-applicable"]},"evidenceRef":{"type":["string","null"],"maxLength":300},"notes":{"type":["string","null"],"maxLength":1000}}
    }
  }
}
